# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key

# Password to open the CRM (browser asks for it; username can be anything)
CRM_PASSWORD=choose-a-strong-password

# Time zone used for reminders (India)
TZ_OFFSET=+05:30

# WhatsApp (fill these later, after Meta setup)
WHATSAPP_VERIFY_TOKEN=any-secret-word-you-choose
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
